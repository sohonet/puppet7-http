# Ruby 3 compatibility: Requires the following gems to be installed:
# gem install sinatra webrick rack
require 'rubygems'
require 'sinatra/base'
require 'webrick'
require 'logger'
require 'json'
<% if @ssl_enable %>
require 'openssl'
<% end %>

# Global vars
LOGDIR          = File.expand_path(File.dirname(__FILE__)) + '/../logs'
SERVER_LOGFILE  = LOGDIR + '/server.log'
SESSION_LOG     = LOGDIR + '/session.log'

# Reset some envs
ENV['HOME']     = '/root'
ENV['PATH']     = '/sbin:/usr/sbin:/bin:/usr/bin:/opt/puppet/bin'
ENV['RACK_ENV'] = '<%= @rack_env %>'

# Implement an access log for robust logging of user info and access and git output
LOG = Logger.new(SESSION_LOG)
LOG.info("Setting session log at #{SESSION_LOG}")
LOG.info("Setting server log at #{SERVER_LOGFILE}")

# Configure Sinatra settings
class Server < Sinatra::Base
  configure do
    set :port, <%= @port %>
    set :bind, '<%= @bind_address %>'
    set :server, 'webrick'
    set :logging, true
    set :environment, :<%= @rack_env %>
    
    # WEBrick specific options
    set :server_settings, {
      :Logger => WEBrick::Log::new(SERVER_LOGFILE, WEBrick::Log::DEBUG),
      :AccessLog => [[File.open(SERVER_LOGFILE, 'a'), WEBrick::AccessLog::COMMON_LOG_FORMAT]],
<% if @ssl_enable %>
      :SSLEnable => true,
      :SSLCertificate => OpenSSL::X509::Certificate.new(File.open('<%= @cert_path %>').read),
      :SSLPrivateKey => OpenSSL::PKey::RSA.new(File.open('<%= @key_path %>').read),
      :SSLCertName => [ [ "CN", WEBrick::Utils::getservername ] ]
<% else %>
      :SSLEnable => false
<% end %>
    }
  end

  # Route definitions
  <% @routes.each do |route,param| %>
    <%= param['method'] %> '/<%= route %>' do
      begin
        LOG.info("Executing command: <%= param['command'] %>")
        command = "<%= param['command'] %>"
        
        if command.nil? || command.empty?
          LOG.error("Command is nil or empty for route <%= route %>")
          halt 500, "Command not configured"
        end
        
        IO.popen(command + " 2>&1") do |output|
          output.each do |line|
            LOG.info("Command output: #{line.strip.chomp}")
          end
        end
        
        exit_status = $?.exitstatus
        LOG.info("Command completed with exit status: #{exit_status}")
        
<% if @custom_response_handler -%>
        # Custom response handler
        <%= @custom_response_handler %>
<% else -%>
        # Default generic response handler
        if exit_status == 0
          status 200
          "Command succeeded"
        else
          status 500
          "Command failed with exit code: #{exit_status}"
        end
<% end -%>
        
      rescue => e
        LOG.error("Error executing command: #{e.message}")
        LOG.error(e.backtrace.join("\n"))
        halt 500, "Internal server error"
      end
    end
  <% end %>

  not_found do
    halt 404, 'You shall not pass! (page not found)'
  end
end

# Setup signal handling
[:INT, :TERM].each do |sig|
  trap(sig) do
    puts "Received #{sig}, shutting down..."
    exit
  end
end

# Start the server
Server.run!

