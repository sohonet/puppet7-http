{
  "name": "sohonet-http",
  "version": "0.2.0",
  "author": "Jeff Malnick, Sohonet",
  "summary": "HTTP webhook listener module with Ruby 3 support",
  "license": "Apache-2.0",
  "source": "https://github.com/sohonet/puppet7-http",
  "project_page": "https://github.com/sohonet/puppet7-http",
  "issues_url": "https://github.com/sohonet/puppet7-http/issues",
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 7.0.0 < 9.0.0"
    }
  ],
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    },
    {
      "name": "puppet/systemd", 
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "20.04",
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "10",
        "11",
        "12"
      ]
    }
  ]
}
